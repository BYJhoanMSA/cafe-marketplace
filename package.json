    "@sanity/image-url": "^1.0.2",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.1.16",
    "next": "^15.5.21",
    "next-auth": "^5.0.0-beta.32",
    "next-sanity": "^9.8.21",
    "node-cache": "^5.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.8.0",
    "slugify": "^1.6.9",
